diff -ruN a/kernel/common/inc/nv-mm.h b/kernel/common/inc/nv-mm.h
--- a/kernel/common/inc/nv-mm.h	2024-01-26 03:08:33.000000000 +0800
+++ b/kernel/common/inc/nv-mm.h	2026-11-07 18:38:25.572957010 +0800
@@ -295,7 +295,16 @@
 static inline void nv_vm_flags_set(struct vm_area_struct *vma, vm_flags_t flags)
 {
 #if defined(NV_VM_AREA_STRUCT_HAS_CONST_VM_FLAGS)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+    /*
+     * 7.0: vm_flags_set() 内部调用 __vma_start_write()，该符号是 GPL-only，
+     * 而 nvidia.ko 非 GPL 许可。此处均在 ->mmap() 阶段调用，VMA 尚未挂入
+     * VMA 树，因此使用内核提供的无锁版本 __vm_flags_mod()。
+     */
+    __vm_flags_mod(vma, flags, 0);
+#else
     vm_flags_set(vma, flags);
+#endif
 #else
     vma->vm_flags |= flags;
 #endif
@@ -304,7 +313,12 @@
 static inline void nv_vm_flags_clear(struct vm_area_struct *vma, vm_flags_t flags)
 {
 #if defined(NV_VM_AREA_STRUCT_HAS_CONST_VM_FLAGS)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+    /* 同上：避开 GPL-only 的 __vma_start_write() */
+    __vm_flags_mod(vma, 0, flags);
+#else
     vm_flags_clear(vma, flags);
+#endif
 #else
     vma->vm_flags &= ~flags;
 #endif
