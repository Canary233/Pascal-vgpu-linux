diff -ruN a/kernel/common/inc/nv-compat-70.h b/kernel/common/inc/nv-compat-70.h
--- a/kernel/common/inc/nv-compat-70.h	1970-01-01 08:00:00.000000000 +0800
+++ b/kernel/common/inc/nv-compat-70.h	2026-11-07 20:47:23.223731690 +0800
@@ -0,0 +1,44 @@
+/*
+ * Linux 7.0 compatibility shims for the 535.161.05 vGPU kernel modules.
+ *
+ * 内核 7.0 的若干改动使上游 conftest 探测失效或 API 被直接移除，这里统一收敛：
+ *   - struct vm_area_struct.vm_flags 变为 const（与 vma_flags_t flags 组成 union），
+ *     conftest 通过 offsetof(__vm_flags) 的探测不再命中，显式置位。
+ *   - in_irq() 被移除，等价 API 为 in_hardirq()。
+ *   - del_timer_sync() 更名为 timer_delete_sync()。
+ */
+
+#ifndef __NV_COMPAT_70_H__
+#define __NV_COMPAT_70_H__
+
+#include <linux/version.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+
+#ifndef NV_VM_AREA_STRUCT_HAS_CONST_VM_FLAGS
+#define NV_VM_AREA_STRUCT_HAS_CONST_VM_FLAGS 1
+#endif
+
+#ifndef in_irq
+#define in_irq() in_hardirq()
+#endif
+
+#ifndef del_timer_sync
+#define del_timer_sync(timer) timer_delete_sync(timer)
+#endif
+
+#ifndef no_llseek
+#define no_llseek noop_llseek
+#endif
+
+/*
+ * 7.0: vfio 核心接管 VFIO_DEVICE_GET_REGION_INFO，region 信息改由
+ * vfio_device_ops::get_region_info_caps 回调提供。
+ */
+#ifndef NV_VFIO_DEVICE_OPS_HAS_GET_REGION_INFO_CAPS
+#define NV_VFIO_DEVICE_OPS_HAS_GET_REGION_INFO_CAPS 1
+#endif
+
+#endif /* LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0) */
+
+#endif /* __NV_COMPAT_70_H__ */
