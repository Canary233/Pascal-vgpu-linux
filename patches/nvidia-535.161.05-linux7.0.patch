diff -ruN a/kernel/nvidia/os-mlock.c b/kernel/nvidia/os-mlock.c
--- a/kernel/nvidia/os-mlock.c	2024-01-26 03:08:32.000000000 +0800
+++ b/kernel/nvidia/os-mlock.c	2026-11-07 18:38:25.573017329 +0800
@@ -30,7 +30,53 @@
                                 unsigned long address,
                                 unsigned long *pfn)
 {
-#if defined(NV_UNSAFE_FOLLOW_PFN_PRESENT)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+    /*
+     * 7.0 移除了 follow_pfn()，官方替代 follow_pfnmap_start() 是 GPL-only 导出，
+     * nvidia.ko 无法使用。这里做一次只读的页表遍历，语义与 follow_pfn() 一致：
+     * 成功返回 0 并给出 pfn，失败返回负值。
+     * 调用方（os_lookup_user_io_memory）已持有 mmap_lock 读锁。
+     */
+    struct mm_struct *mm = vma->vm_mm;
+    pgd_t *pgd;
+    p4d_t *p4d;
+    pud_t *pud;
+    pmd_t *pmd;
+    pte_t *pte;
+
+    pgd = pgd_offset(mm, address);
+    if (pgd_none(*pgd) || pgd_bad(*pgd))
+        return -EINVAL;
+
+    p4d = p4d_offset(pgd, address);
+    if (p4d_none(*p4d))
+        return -EINVAL;
+
+    pud = pud_offset(p4d, address);
+    if (pud_none(*pud))
+        return -EINVAL;
+    if (pud_leaf(*pud))
+    {
+        *pfn = pud_pfn(*pud);
+        return 0;
+    }
+
+    pmd = pmd_offset(pud, address);
+    if (pmd_none(*pmd))
+        return -EINVAL;
+    if (pmd_leaf(*pmd))
+    {
+        *pfn = pmd_pfn(*pmd);
+        return 0;
+    }
+
+    pte = pte_offset_kernel(pmd, address);
+    if (!pte_present(*pte))
+        return -EINVAL;
+
+    *pfn = pte_pfn(*pte);
+    return 0;
+#elif defined(NV_UNSAFE_FOLLOW_PFN_PRESENT)
     return unsafe_follow_pfn(vma, address, pfn);
 #else
     return follow_pfn(vma, address, pfn);
